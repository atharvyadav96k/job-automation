POSTGRES_USER=jobauto
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobauto

DATABASE_URL=postgres://jobauto:changeme@localhost:5432/jobauto?sslmode=disable
REDIS_URL=redis://localhost:6379

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

API_BASIC_AUTH_USER=
API_BASIC_AUTH_PASS=

# Used by docker-compose only (frontend built with this baked in as the API URL)
API_BASE_URL=http://localhost:8080
# Used by the app service's CORS middleware to allow the frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Job discovery (Phase 1)
SCRAPE_INTERVAL=4h
REMOTIVE_ENABLED=true
# JSearch (OpenWeb Ninja, api.openwebninja.com) — India-focused software
# developer search matching your skills. Metered API (free tier: 200
# requests/month per key): only runs on a manual Scan click, never on the
# automatic scheduled ticker. Comma-separate multiple keys to spread quota
# across accounts — a failed key automatically falls over to the next one.
JSEARCH_ENABLED=true
JSEARCH_API_KEYS=
JSEARCH_COUNTRY=in

# GitHub evidence ingestion (Phase 1.5) — token is optional, only needed for
# higher rate limits or to include private repos as evidence
GITHUB_USERNAME=
GITHUB_TOKEN=
